<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- PRESENTATION: HTTP-точка входа. Знает все слои только ради сборки DI. -->
    <PropertyGroup>
        <RootNamespace>Pingboard.Api</RootNamespace>
        <AssemblyName>Pingboard.Api</AssemblyName>
        <UserSecretsId>dotnet-Pingboard.Api</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
        <PackageReference Include="Scalar.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pingboard.Application\Pingboard.Application.csproj"/>
        <ProjectReference Include="..\Pingboard.Infrastructure\Pingboard.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- `Monitor` иначе конфликтует с System.Threading.Monitor (ImplicitUsings подключает System.Threading). -->
    <ItemGroup>
        <Using Include="Pingboard.Domain.Entities.Monitor" Alias="Monitor"/>
    </ItemGroup>

    <!-- Тесты проверяют маппинг исключений в HTTP-статусы (ExceptionStatusMapper) — это
         чистая функция, и её разбор (битый JSON, SQLSTATE 23505, транзиентность Postgres)
         проверяется без поднятия HTTP-хоста. -->
    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Pingboard.Application.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
