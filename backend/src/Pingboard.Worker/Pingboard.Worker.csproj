<Project Sdk="Microsoft.NET.Sdk">

    <!--
      ВТОРОЙ PROCESS TYPE (фактор VIII): тот же код, другая команда запуска.
  
      Sdk="Microsoft.NET.Sdk", а не Microsoft.NET.Sdk.Worker: Worker-SDK требует пакет
      Microsoft.Extensions.Hosting, которого нет в оффлайн-фиде этой машины.
      Хост собирается вручную на Microsoft.Extensions.Hosting.Abstractions
      (см. Hosting/WorkerHost.cs) — там же инструкция, как вернуть штатный Worker SDK.
    -->
    <PropertyGroup>
        <RootNamespace>Pingboard.Worker</RootNamespace>
        <AssemblyName>Pingboard.Worker</AssemblyName>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pingboard.Application\Pingboard.Application.csproj"/>
        <ProjectReference Include="..\Pingboard.Infrastructure\Pingboard.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- `Monitor` иначе конфликтует с System.Threading.Monitor (ImplicitUsings подключает System.Threading). -->
    <ItemGroup>
        <Using Include="Pingboard.Domain.Entities.Monitor" Alias="Monitor"/>
    </ItemGroup>

</Project>
