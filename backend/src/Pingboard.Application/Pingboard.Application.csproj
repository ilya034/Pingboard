<Project Sdk="Microsoft.NET.Sdk">

    <!-- Зависит ТОЛЬКО от Domain. -->
    <PropertyGroup>
        <RootNamespace>Pingboard.Application</RootNamespace>
        <AssemblyName>Pingboard.Application</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pingboard.Domain\Pingboard.Domain.csproj"/>
    </ItemGroup>

    <!-- `Monitor` иначе конфликтует с System.Threading.Monitor (ImplicitUsings подключает System.Threading). -->
    <ItemGroup>
        <Using Include="Pingboard.Domain.Entities.Monitor" Alias="Monitor"/>
    </ItemGroup>

</Project>
