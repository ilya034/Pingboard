# k8s/dev.env.example → скопируйте в k8s/dev.env (он в .gitignore) и заполните.
# Формат — как у .env для docker compose: KEY=VALUE, по строке на ключ.
# scripts/k3d-up.ps1 создаёт из этого файла Secret pingboard-secrets:
#   kubectl -n pingboard create secret generic pingboard-secrets --from-env-file=k8s/dev.env
#
# ВАЖНО: пароль в POSTGRES_PASSWORD и в строке подключения обязан совпадать.

POSTGRES_PASSWORD=change-me-postgres
ConnectionStrings__Default=Host=postgres;Port=5432;Database=pingboard;Username=pingboard;Password=change-me-postgres
JWT_SECRET=change-me-minimum-32-bytes-long-secret
