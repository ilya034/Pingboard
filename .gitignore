# ── .NET ─────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.binlog

# ── Артефакты сборки / публикации ────────────────────────────────────────────
artifacts/
publish/
[Dd]ebug/
[Rr]elease/

# ── Секреты и локальная конфигурация (фактор III) ────────────────────────────
.env
.env.*
!.env.example
appsettings.Production.json
appsettings.Local.json
secrets.json
# Секреты локального k8s-стенда: из этого файла scripts/k3d-up.ps1 создаёт Secret.
# Рядом лежит k8s/dev.env.example — он в git.
k8s/dev.env

# ── Локальный оффлайн-фид NuGet ──────────────────────────────────────────────
# Восстанавливается скриптом scripts/build-local-feed.ps1, в git не нужен (~150 МБ).
# Лежит в корне репозитория: источник ".packages" в NuGet.config относительный
# и разрешается относительно каталога самого конфига.
.packages/

# ── Node / фронтенд ──────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Кэш npm внутри репозитория: в песочнице DSH запись в %LOCALAPPDATA%\npm-cache
# запрещена (EPERM), поэтому npm запускается с --cache .npm-cache (см. SANDBOX.md §6).
.npm-cache/

# ── Логи и временные файлы ───────────────────────────────────────────────────
*.log
logs/
test.log
build.log
restore.log

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Тестовые артефакты ───────────────────────────────────────────────────────
[Tt]est[Rr]esult*/
coverage/
*.trx
