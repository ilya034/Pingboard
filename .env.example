# ─────────────────────────────────────────────────────────────────────────────
# Pingboard — шаблон конфигурации (фактор III: всё из окружения).
# Скопируйте в .env и заполните: cp .env.example .env
# .env в git НЕ попадает; секретов в appsettings.json нет.
# ─────────────────────────────────────────────────────────────────────────────

# ── Общее ────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
# MVP: схема приводится миграциями на старте Api. M5: MigrateOnStart=false + отдельный процесс pingboard-migrate.
MigrateOnStart=true

# ── Backing services (фактор IV) ─────────────────────────────────────────────
POSTGRES_USER=pingboard
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pingboard

# Строка подключения: __ — нотация вложенных ключей (.NET), хост postgres — имя сервиса в compose.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=pingboard;Username=pingboard;Password=change-me-postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
# Секрет подписи HS256, минимум 32 байта. Сгенерировать: openssl rand -base64 48
# Development: оставьте пустым — Api сгенерирует эфемерный секрет на запуск
#   (в логе будет warning, и все выданные токены станут недействительны после рестарта).
# Любое другое окружение: секрет обязателен, без него процесс не стартует.
# ВАЖНО: не оставляйте здесь плейсхолдер-заглушку нужной длины — она пройдёт проверку
# длины и уедет в прод как настоящий ключ подписи, известный всем, кто видел репозиторий.
Jwt__Secret=
Jwt__ExpiresMinutes=120
Jwt__Issuer=pingboard
Jwt__Audience=pingboard

# Сид-демо-пользователь: владельцем запросов больше не является (владелец берётся из
# claim sub access-токена), но этой учёткой удобно войти: POST /api/auth/login.
# Вне Development сид запрещён (пароль известен из исходников) — там аккаунт создаётся
# обычной регистрацией. Id демо-учётки берётся из кода (DemoUser.Id), а не из конфигурации.
Auth__DefaultUserEmail=demo@pingboard.local
Auth__DefaultUserPassword=demo-password

# Rate limit на /api/auth/*: каждый запрос логина/регистрации считает PBKDF2 (210k итераций),
# то есть это ещё и защита CPU. Политики раздельные: регистрация строже логина (она пишет в БД).
# Ключ раздела — адрес соединения, поэтому за nginx все клиенты попадают в один раздел
# (адрес прокси) — включите ForwardedHeaders ниже: README §6.5.
RateLimit__LoginPermitLimit=20
RateLimit__RegisterPermitLimit=10
RateLimit__AuthWindowSeconds=60

# Доверенные заголовки прокси. Включать ТОЛЬКО там, где Api доступен исключительно через
# свой прокси: иначе клиент подставит X-Forwarded-For и обойдёт лимит на логин.
# Задайте адрес(а) прокси и/или сеть compose: ForwardedHeaders__KnownNetworks__0=172.16.0.0/12
ForwardedHeaders__Enabled=false
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__0=

# ── Воркер и проверки ────────────────────────────────────────────────────────
# Таймаут одной попытки проверки.
Probe__TimeoutMs=5000
# Барьер SSRF: по умолчанию пробер ходит только на публичные адреса (loopback, 10/8,
# 172.16/12, 192.168/16, 169.254/16 и прочие служебные диапазоны запрещены). Включать
# true можно только на доверенном стенде: это снова открывает доступ во внутреннюю сеть.
Probe__AllowPrivateNetworks=false

Worker__TickSeconds=5
Worker__MaxParallel=8
Worker__BatchSize=100
# Файл-пульс для healthcheck воркера (у воркера нет HTTP-порта). Пусто — не писать.
Worker__HeartbeatPath=/tmp/pingboard-worker-heartbeat

# ── Api-специфика ────────────────────────────────────────────────────────────
# Источники для CORS (dev-фронт Vite на 5173; в compose фронт отдаёт nginx).
Cors__Origins__0=http://localhost:5173

# Окно и сегменты полосы доступности на дашборде.
Monitors__UptimeWindowHours=24
Monitors__UptimeBarSegments=24

# ── Порты стенда (подстановка в docker-compose.yml) ──────────────────────────
# Куда публиковать Api. Dev-стенд: как есть — Api нужен с хоста для curl и smoke-скриптов.
# «Прод»: поставьте 127.0.0.1:8080 — Api останется доступен с самого хоста (curl, отладка),
# но не из интернета: снаружи трафик идёт только через nginx (WEB_BIND). Порт Api в prod-файле
# намеренно не переопределяется: compose складывает списки ports, поэтому точка настройки одна.
# ВАЖНО: не указывайте здесь 8081 — этот порт занят web-контейнером (WEB_BIND), и compose
# упадёт на «port is already allocated».
API_BIND=0.0.0.0:8080
# Порт web-контейнера (профиль web) на хосте. 8081, а не 8080: 8080 занят самим Api.
# «Прод»: 127.0.0.1:8081 плюс TLS-терминатор на хосте (nginx/Caddy) перед ним — DEPLOY.md §5.4.
WEB_BIND=8081

# Глубина истории проверок на дашборде: идёт в детали монитора и в «последнюю задержку».
# Полоса доступности считается НЕ из неё, а отдельным агрегатом по сегментам: иначе на
# мониторе с интервалом 10 с она покрывала бы только хвост суточного окна (8640 проверок).
Monitors__DashboardHistoryPerMonitor=500
