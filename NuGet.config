<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Оффлайн-режим restore.

    На этой машине nuget.org недоступен (TLS-ошибка NU1301), поэтому в качестве
    источника используется локальный фид .packages — выгрузка пакетов из
    ~/.nuget/packages (см. README, раздел «Оффлайн-restore»).

    Плюс: сборка воспроизводима и не требует сети.
    Минус: чтобы добавить НОВЫЙ пакет, нужно сначала положить его .nupkg
    в .packages (или временно раскомментировать nuget.org ниже).
  -->
  <packageSources>
    <clear />
    <add key="local-offline" value=".packages" />
  </packageSources>

  <!--
    Вернуть nuget.org (когда сеть/TLS снова доступны) — раскомментировать:

    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  -->

</configuration>
