# deploy/Dockerfile.api — ОДИН образ для api и worker (фактор VIII: один релиз, разные команды).
# Сборка всегда из корня репозитория: docker build -f deploy/Dockerfile.api .

# ── build ────────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Сначала только манифесты зависимостей: слой restore кэшируется отдельно от кода (фактор II/V).
# Копируем их в те же места, что и в репозитории: Directory.Build.props MSBuild ищет вверх по
# дереву (поэтому /src/Directory.Build.props покрывает /src/backend/**), а центральные версии
# пакетов лежат в backend/Directory.Packages.props.
#
# NuGet.config сюда НЕ копируется осознанно: в нём единственный источник — оффлайн-фид
# .packages, а этот каталог в git не хранится (восстанавливается scripts/build-local-feed.ps1
# из локального кэша машины). В образе restore идёт прямо в nuget.org: сеть на этапе сборки
# образа всё равно нужна, иначе не вытянуть сам базовый образ SDK.
COPY Directory.Build.props /src/
COPY backend/Directory.Packages.props backend/
COPY backend/src/Pingboard.Domain/*.csproj backend/src/Pingboard.Domain/
COPY backend/src/Pingboard.Application/*.csproj backend/src/Pingboard.Application/
COPY backend/src/Pingboard.Infrastructure/*.csproj backend/src/Pingboard.Infrastructure/
COPY backend/src/Pingboard.Api/*.csproj backend/src/Pingboard.Api/
COPY backend/src/Pingboard.Worker/*.csproj backend/src/Pingboard.Worker/
RUN dotnet restore backend/src/Pingboard.Api/Pingboard.Api.csproj --source https://api.nuget.org/v3/index.json \
    && dotnet restore backend/src/Pingboard.Worker/Pingboard.Worker.csproj --source https://api.nuget.org/v3/index.json

COPY backend/ backend/
RUN dotnet publish backend/src/Pingboard.Api/Pingboard.Api.csproj -c Release -o /app --no-restore
RUN dotnet publish backend/src/Pingboard.Worker/Pingboard.Worker.csproj -c Release -o /app/worker --no-restore
# Обе точки входа в одном образе: /app — Api, /app/worker — Worker.

# ── runtime ──────────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

# Версия релиза приходит build-arg'ом (в compose это build.args.APP_VERSION). Вместе с тегом
# образа (IMAGE_TAG, фактор V) это отвечает на вопрос «что именно закатано»:
#   docker image inspect pingboard-api:0.1.0 \
#     --format '{{ index .Config.Labels "org.opencontainers.image.version" }}'
ARG APP_VERSION=0.0.0
LABEL org.opencontainers.image.title="pingboard-api" \
      org.opencontainers.image.description="Pingboard: Api и Worker — один образ, две команды (фактор VIII)" \
      org.opencontainers.image.version="$APP_VERSION"

# curl нужен healthcheck'у compose.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app ./

# Непривилегированный пользователь: процесс не должен быть root.
USER $APP_UID

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

# Воркер переопределяет команду в compose: ["dotnet", "worker/Pingboard.Worker.dll"]
CMD ["dotnet", "Pingboard.Api.dll"]
