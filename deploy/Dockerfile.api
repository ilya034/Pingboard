FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props /src/
COPY backend/Directory.Packages.props backend/
COPY backend/src/Pingboard.Domain/*.csproj backend/src/Pingboard.Domain/
COPY backend/src/Pingboard.Application/*.csproj backend/src/Pingboard.Application/
COPY backend/src/Pingboard.Infrastructure/*.csproj backend/src/Pingboard.Infrastructure/
COPY backend/src/Pingboard.Api/*.csproj backend/src/Pingboard.Api/
COPY backend/src/Pingboard.Worker/*.csproj backend/src/Pingboard.Worker/


COPY backend/src/Pingboard.Domain/packages.lock.json backend/src/Pingboard.Domain/
COPY backend/src/Pingboard.Application/packages.lock.json backend/src/Pingboard.Application/
COPY backend/src/Pingboard.Infrastructure/packages.lock.json backend/src/Pingboard.Infrastructure/
COPY backend/src/Pingboard.Api/packages.lock.json backend/src/Pingboard.Api/
COPY backend/src/Pingboard.Worker/packages.lock.json backend/src/Pingboard.Worker/

RUN dotnet restore backend/src/Pingboard.Api/Pingboard.Api.csproj --source https://api.nuget.org/v3/index.json --locked-mode \
    && dotnet restore backend/src/Pingboard.Worker/Pingboard.Worker.csproj --source https://api.nuget.org/v3/index.json --locked-mode

COPY backend/ backend/
RUN dotnet publish backend/src/Pingboard.Api/Pingboard.Api.csproj -c Release -o /app --no-restore
RUN dotnet publish backend/src/Pingboard.Worker/Pingboard.Worker.csproj -c Release -o /app/worker --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime


ARG APP_VERSION=0.0.0
LABEL org.opencontainers.image.title="pingboard-api" \
      org.opencontainers.image.description="Pingboard: Api и Worker — один образ, две команды (фактор VIII)" \
      org.opencontainers.image.version="$APP_VERSION"

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app ./

USER $APP_UID

EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

CMD ["dotnet", "Pingboard.Api.dll"]
