# deploy/Dockerfile.web — node собирает SPA, nginx отдаёт статику и проксирует /api.
# Сборка из корня репозитория: docker build -f deploy/Dockerfile.web .

# ── build ────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /frontend

# Путь к документации API (Scalar/Swagger). Api отдаёт её только в Development, поэтому это
# build-arg, а не константа: на стенде с ASPNETCORE_ENVIRONMENT=Development SPA ставит ссылку
# (через nginx того же контейнера web), а в «проде» переменная пустая и ссылки нет вовсе.
# Раньше адрес был захардкожен как http://localhost:8080/scalar/v1 — на VPS и в k8s он вёл
# на машину пользователя, а не на стенд. По умолчанию пусто, то есть «безопасное» поведение:
# передаёт значение только тот, кто собирает стенд в Development (deploy/docker-compose.yml).
ARG VITE_API_DOCS_PATH=""
ENV VITE_API_DOCS_PATH=$VITE_API_DOCS_PATH

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ── runtime ──────────────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

# Непривилегированный конфиг: слушает 8080, pid и буферы — в /tmp (см. deploy/nginx.container.conf).
# Это тот же образ, что в compose, но его можно запускать и под k8s с runAsNonRoot (фактор X:
# одно поведение в двух средах, отличие только в оркестраторе).
COPY deploy/nginx.container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /frontend/dist /usr/share/nginx/html

# wget берётся из busybox, который уже есть в alpine: отдельный пакет не нужен.
# HEALTHCHECK работает в Docker/compose; в k8s пробы описаны в манифесте.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz > /dev/null || exit 1

# Пользователь nginx из образа (uid 101). Порт 8080 — непривилегированный.
USER nginx

EXPOSE 8080
